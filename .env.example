# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Travelpayouts (Aviasales Data API) ---
# Free token: https://www.travelpayouts.com -> Tools -> API tokens
TRAVELPAYOUTS_TOKEN=
# Affiliate marker (optional) — appended to deep links so you earn commission
TRAVELPAYOUTS_MARKER=

# --- Runtime ---
# Defaults for a brand-new user only — each user picks their own in ⚙️ Settings.
CURRENCY=krw
# Point of sale for fares (country code) — kr = buying from Korea
MARKET=kr
DEFAULT_LANG=uz
# How often the poller checks whether anyone's delivery hour has come (not how
# often a route is priced — that is twice a day, at the hour each user picked).
POLL_TICK_SECONDS=900
TOP_N=3
# DRY_RUN=true logs the digest instead of sending. Set false to send to Telegram.
DRY_RUN=true

# --- Capacity ---
# Simultaneous browser pages (Trip.com). Each costs ~350MB — raise only with RAM to spare.
BROWSER_CONCURRENCY=3
# Routes the poller works on at the same time
ROUTE_CONCURRENCY=4
# How long a finished search is reused for (seconds)
CACHE_TTL_SECONDS=1800
# Minimum gap between one user's live searches (seconds)
SEARCH_COOLDOWN_SECONDS=60

# --- Duffel (flight offers API — full schedule) ---
DUFFEL_TOKEN=duffel_test_xxx

# --- Target-price alerts ---
# How often watches carrying a target price are re-checked between digests (seconds).
# Only watches with a target are scanned, so this costs nothing for everyone else.
ALERT_SCAN_SECONDS=3600

# --- Deals channel (optional) ---
# Public channel where unusually cheap fares are posted. Leave empty to post nothing.
# The bot must be an admin of the channel. Example: @ticketcatch_deals or -1001234567890
DEALS_CHANNEL_ID=
# How far under the route's usual price a fare must be before it is worth posting (%)
DEAL_DISCOUNT_PERCENT=15
# Don't announce the same route again inside this window (hours)
DEAL_REPEAT_HOURS=24
